# Copie este arquivo para .env e preencha com os dados do projeto no Supabase.
# A chave publishable (sb_publishable_...) é pública e vai no app.
# Se o painel só mostrar a chave anon antiga, ela também serve neste campo.
# Nunca cole a chave secret (sb_secret_...) nem a service_role.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
